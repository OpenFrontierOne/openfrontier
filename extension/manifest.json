{
  "manifest_version": 3,
  "name": "OFO Copilot",
  "description": "Open Frontier One companion for learning, building, publishing, and connecting across OFO-owned stores.",
  "version": "0.1.0",
  "action": {
    "default_title": "OFO Copilot"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://openfrontier.one/*",
        "https://*.openfrontier.one/*",
        "https://openfrontier.pages.dev/*",
        "https://openfrontier-docs.pages.dev/*",
        "https://freequantumstore.pages.dev/*",
        "https://freecryptostore.pages.dev/*",
        "https://freechipstore.pages.dev/*",
        "https://freespacestore.pages.dev/*",
        "https://freebiostore.pages.dev/*",
        "https://freedesignstore.pages.dev/*",
        "https://freemarketingstore.pages.dev/*",
        "https://freecodestore.pages.dev/*",
        "https://freemusicstore.pages.dev/*",
        "https://freewritingstore.pages.dev/*",
        "https://freebookstore.pages.dev/*",
        "https://freefinancestore.pages.dev/*",
        "https://freedatastore.pages.dev/*",
        "https://freepeerstore.pages.dev/*",
        "https://freeappstore.online/*",
        "https://*.freeappstore.online/*",
        "https://proappstore.online/*",
        "https://*.proappstore.online/*",
        "https://freegamestore.online/*",
        "https://*.freegamestore.online/*",
        "https://progamestore.online/*",
        "https://*.progamestore.online/*",
        "https://freewebstore.online/*",
        "https://*.freewebstore.online/*",
        "https://prowebstore.online/*",
        "https://*.prowebstore.online/*",
        "https://freeagentstore.online/*",
        "https://*.freeagentstore.online/*",
        "https://proagentstore.online/*",
        "https://*.proagentstore.online/*"
      ],
      "js": ["src/domains.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://openfrontier.one/*",
    "https://*.openfrontier.one/*",
    "https://openfrontier.pages.dev/*",
    "https://openfrontier-docs.pages.dev/*",
    "https://freequantumstore.pages.dev/*",
    "https://freecryptostore.pages.dev/*",
    "https://freechipstore.pages.dev/*",
    "https://freespacestore.pages.dev/*",
    "https://freebiostore.pages.dev/*",
    "https://freedesignstore.pages.dev/*",
    "https://freemarketingstore.pages.dev/*",
    "https://freecodestore.pages.dev/*",
    "https://freemusicstore.pages.dev/*",
    "https://freewritingstore.pages.dev/*",
    "https://freebookstore.pages.dev/*",
    "https://freefinancestore.pages.dev/*",
    "https://freedatastore.pages.dev/*",
    "https://freepeerstore.pages.dev/*",
    "https://freeappstore.online/*",
    "https://*.freeappstore.online/*",
    "https://proappstore.online/*",
    "https://*.proappstore.online/*",
    "https://freegamestore.online/*",
    "https://*.freegamestore.online/*",
    "https://progamestore.online/*",
    "https://*.progamestore.online/*",
    "https://freewebstore.online/*",
    "https://*.freewebstore.online/*",
    "https://prowebstore.online/*",
    "https://*.prowebstore.online/*",
    "https://freeagentstore.online/*",
    "https://*.freeagentstore.online/*",
    "https://proagentstore.online/*",
    "https://*.proagentstore.online/*"
  ],
  "permissions": ["activeTab", "sidePanel", "storage"],
  "side_panel": {
    "default_path": "src/sidepanel.html"
  }
}
