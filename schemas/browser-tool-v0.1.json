{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openfrontier.one/schemas/browser-tool-v0.1.json",
  "title": "OFO Browser Tool Manifest",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "description", "url", "privacy", "inputSchema", "output", "permissions"],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "id": { "type": "string", "pattern": "^ofo\\.[a-z0-9.-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "format": "uri" },
    "privacy": { "enum": ["local-only", "network-optional", "network-required"] },
    "deterministic": { "type": "boolean" },
    "inputSchema": { "type": "object" },
    "output": {
      "type": "object",
      "required": ["type", "transport"],
      "properties": {
        "type": { "enum": ["artifact", "structured-data", "text"] },
        "transport": { "enum": ["blob", "json", "text"] }
      }
    },
    "permissions": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    }
  },
  "additionalProperties": true
}
